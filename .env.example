# Your institution's Moodle base URL. Include a subdirectory if Moodle uses one.
# For Lehigh CourseSite, use https://coursesite.lehigh.edu
MOODLE_URL=https://moodle.example.edu

# Your own Moodle web-service token. Never share a filled-in .env file.
MOODLE_TOKEN=

# Apple Maps: a MapKit JS web token, not an Apple private .p8 signing key.
# Keep the token domain-restricted; see visualizations/README.md for setup.
APPLE_MAPS_TOKEN=
# Optional dedicated HTTPS widget origin; otherwise ChatGPT uses its default.
APPLE_MAPS_WIDGET_DOMAIN=
